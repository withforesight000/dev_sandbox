# Host-side files generated by prepare-mounts.
.devcontainer/compose.allowlist.local.yml
.devcontainer/allowlist.local.tsv
.devcontainer/.docker-gid

# User-specific agent settings and credentials.
# Keep .agents/skills and the .claude/skills symlink tracked.
.codex/settings.local.toml
.claude/settings.local.json
.codex/auth.json
.claude/.credentials.json

# Python caches, virtual environments, and tool state.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local logs and operating-system metadata.
*.log
.DS_Store
Thumbs.db
